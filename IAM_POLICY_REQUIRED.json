{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowIAMManagementForClients",
            "Effect": "Allow",
            "Action": [
                "iam:CreateUser",
                "iam:DeleteUser",
                "iam:CreateAccessKey",
                "iam:DeleteAccessKey",
                "iam:ListAccessKeys",
                "iam:UpdateAccessKey",
                "iam:PutUserPolicy",
                "iam:DeleteUserPolicy",
                "iam:GetUser"
            ],
            "Resource": "arn:aws:iam::*:user/client_*"
        },
        {
            "Sid": "AllowS3Management",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetObject",
                "s3:DeleteObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::app-centric-digitech",
                "arn:aws:s3:::app-centric-digitech/*"
            ]
        }
    ]
}
